# market-agri-auth-api — every variable this repository reads.
# Copy to .env (ignored by git) for a local run. Placeholders only: never commit real values.

# ─── Read by the application (auth-app/src/main/resources/application.yml) ───

# HTTP port inside the container / on the local machine
PORT=8080

# PostgreSQL. The schema belongs to market-agri-auth-db; this repository never migrates it.
DATABASE_URL=jdbc:postgresql://localhost:5432/auth
DATABASE_USER=<auth-db-user>
DATABASE_PASSWORD=<auth-db-password>

# RS256 signing key. auth is the ONLY service that holds the private key.
# PEM on a single line, with literal \n between lines (as .env stores it).
JWT_PRIVATE_KEY=<-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY----->
JWT_PUBLIC_KEY=<-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY----->
# Key id published in the JWKS and in the token header (for example auth-2026-09)
JWT_KEY_ID=<key-id>

# ─── Read by the tests ───

# Integration tests against a real PostgreSQL with the market-agri-auth-db schema.
# Optional: when unset, those tests are skipped instead of failing.
TEST_DATABASE_URL=<jdbc:postgresql://localhost:5432/auth?user=...&password=...>

# ─── Read by deploy/compose.yml (they come from the market-agri-infra .env) ───

AUTH_DB_USER=<auth-db-user>
AUTH_DB_PASSWORD=<auth-db-password>
# JWT_PRIVATE_KEY, JWT_PUBLIC_KEY and JWT_KEY_ID above are also passed through by compose.
