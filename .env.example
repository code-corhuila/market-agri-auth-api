# market-agri-auth-api — every variable this repository reads.
# Copy to .env (ignored by git) for a local run. Placeholders only: never commit real values.

# ─── Read by the application (auth-app/src/main/resources/application.yml) ───

# HTTP port inside the container / on the local machine
PORT=8080

# PostgreSQL. The schema belongs to market-agri-auth-db; this repository never migrates it.
DATABASE_URL=jdbc:postgresql://localhost:5432/market_agri
DATABASE_USER=auth_app
DATABASE_PASSWORD=<auth_app-password>

# Tokens (ADR-020). auth signs with the private key, read from a FILE (never a variable): infra
# mounts keys/<env>/jwt-private.pem; for a local run, point to the one dev-keys.sh wrote.
AUTH_JWT_PRIVATE_KEY_FILE=<path/to/market-agri-infra/keys/dev/jwt-private.pem>
# Key id in the token header and in the JWKS: JWT_KID of the environment
AUTH_JWT_KEY_ID=<JWT_KID>
JWT_ISSUER=market-agri-auth
# The public half, to validate the tokens that reach auth (Annex C 5.3.7): PEM on one line, literal \n
JWT_PUBLIC_KEY=<-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY----->
# Callers of I-01: clientId:sha256-hex-of-the-secret pairs, comma-separated (printf %s "$SECRET" | sha256sum)
AUTH_SERVICE_CLIENTS=<workflow:sha256-hex>
# The initial ADMIN (FR-008): both or neither. Leave them empty in dev and qa (seed users).
AUTH_ADMIN_EMAIL=
AUTH_ADMIN_PASSWORD=

# ─── Read by the tests ───

# Integration tests against a real PostgreSQL with the market-agri-auth-db schema.
# Optional: when unset, those tests are skipped instead of failing.
TEST_DATABASE_URL=<jdbc:postgresql://localhost:55434/market_agri?user=...&password=...>

# ─── Read by deploy/compose.yml (they come from the market-agri-infra env file) ───

PG_DATABASE=market_agri
AUTH_APP_PASSWORD=<auth_app-password>
ENV=<dev|qa|main>
# JWT_ISSUER, JWT_KID, JWT_PUBLIC_KEY and AUTH_SERVICE_CLIENTS too; the private key is the secret
# auth-jwt-private-key that infra declares from keys/<env>/jwt-private.pem.
